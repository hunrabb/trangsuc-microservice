{
  "name": "jewelry-chain",
  "version": "0.0.0",
  "private": true,
  "description": "Hệ thống quản lý chuỗi cửa hàng trang sức",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:messaging": "turbo run test:messaging --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "outbox:requeue": "node scripts/outbox-requeue.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
