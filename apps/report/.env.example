# Biến cho `pnpm dev` trên máy dev (app chạy trên host, Postgres chạy trong Docker).
# Sao chép thành apps/report/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của service khi chạy trên host (mỗi app một cổng khác nhau)
PORT=3004

# Kết nối Postgres, đúng schema + user riêng. Mật khẩu phải khớp REPORT_DB_PASSWORD trong .env ở gốc.
DATABASE_URL=postgresql://report_user:DIEN_MAT_KHAU@localhost:5432/jewelry?schema=report

# Chỉ cho `prisma migrate dev` (database shadow, tạo sẵn bởi infra/postgres/init). Cùng user, cùng schema.
SHADOW_DATABASE_URL=postgresql://report_user:DIEN_MAT_KHAU@localhost:5432/jewelry_shadow?schema=report

# Kiểm tra access token. Sinh khoá: pnpm keys:generate (đường dẫn tính từ thư mục apps/report)
JWT_PUBLIC_KEYS_DIR=../../secrets/jwt/public
JWT_ISSUER=auth-service
JWT_AUDIENCE=store-system
