{
  "name": "@jewelry/report",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "report:backfill:import": "node dist/cli/report-backfill-import.js",
    "test:backfill": "node test/historical-backfill.test.mjs && node test/backfill-file.test.mjs",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node ../../scripts/run-tests.mjs \"src/**/*.test.ts\"",
    "test:stock-reports": "node test/stock-reports.test.mjs",
    "test:excel-export": "node test/report-export.test.mjs",
    "test:dlq": "node test/dlq.test.mjs",
    "test:dlq:rabbit": "node test/dlq-rabbit.test.mjs",
    "test:dlq:postgres": "node test/dlq-postgres.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@jewelry/common": "workspace:*",
    "@jewelry/contracts": "workspace:*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqplib": "2.2.1",
    "exceljs": "4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
