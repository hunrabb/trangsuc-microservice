// Schema Prisma của report-service.
// Prisma 7: URL kết nối KHÔNG nằm ở đây mà ở prisma.config.ts (DATABASE_URL, ?schema=report).

datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // `nest build` không viết lại đường dẫn import: để mặc định sẽ sinh `.ts` và dist không chạy được.
  importFileExtension = "js"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum DlqReplayStatus {
  REQUESTED
  REPUBLISHED
  PUBLISH_FAILED
  PUBLISH_UNCONFIRMED
  PROCESSING_FAILED
}

// Bản sao đọc từ queue observer; thư trong DLQ gốc không bị lấy ra.
model DeadLetterRecord {
  id               String             @id @db.Uuid
  sourceQueue      String
  sourceService    String
  routingKey       String?
  eventType        String?
  eventId          String?            @db.Uuid
  correlationId    String?
  failureKind      String
  failureReason    String
  retryCount       Int?
  content          Bytes
  failedAt         DateTime           @default(now()) @db.Timestamptz(3)
  replayCount      Int                @default(0)
  replayLeaseUntil DateTime?          @db.Timestamptz(3)
  attempts         DlqReplayAttempt[]

  @@index([failedAt, id])
  @@index([sourceService, failedAt])
  @@index([eventType, failedAt])
}

// Audit thao tác: publisher confirm chỉ là REPUBLISHED, không có nghĩa consumer đã xử lý xong.
model DlqReplayAttempt {
  id          String           @id @db.Uuid
  recordId    String           @db.Uuid
  actorId     String           @db.Uuid
  status      DlqReplayStatus  @default(REQUESTED)
  failureCode String?
  requestedAt DateTime         @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?        @db.Timestamptz(3)
  record      DeadLetterRecord @relation(fields: [recordId], references: [id])

  @@index([recordId, requestedAt])
}

// Sự kiện chờ gửi, ghi cùng transaction với dữ liệu nghiệp vụ. Worker trong libs/common gửi đi. id = eventId.
model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json
  correlationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  nextAttemptAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, createdAt])
}

// Chống xử lý trùng: ghi cùng transaction với việc nghiệp vụ. Một thư có thể tới nhiều consumer nên khoá gồm cả consumer.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumer])
}

// Lưu sự kiện kho nguyên bản để Phase 5 dựng bảng tổng hợp, không làm mất backlog hiện tại.
model DeferredStockEvent {
  eventId    String   @id @db.Uuid
  orderId    String   @db.Uuid
  branchId   String   @db.Uuid
  reason     String
  tagCodes   String[]
  occurredAt DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([branchId, occurredAt])
}

// Một dòng mỗi đơn. Doanh thu chỉ ghi khi POS xác nhận tiền; CANCELLED là dấu chặn thư đến lệch thứ tự.
model OrderRevenue {
  orderId   String           @id @db.Uuid
  branchId  String           @db.Uuid
  channel   String
  localDate String
  paidAt    DateTime?        @db.Timestamptz(3)
  revenue   Decimal          @db.Decimal(15, 2)
  cogs      Decimal?         @db.Decimal(15, 2)
  status    String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  lines     OrderLineSales[]

  @@index([localDate, branchId, status])
}

// Mỗi tem một dòng để truy top mẫu và đối chiếu doanh thu, không cộng dồn khi thư lặp.
model OrderLineSales {
  orderId     String       @db.Uuid
  tagCode     String
  variantId   String?      @db.Uuid
  metalId     String?      @db.Uuid
  productName String
  metalWeight Decimal      @db.Decimal(12, 4)
  revenue     Decimal      @db.Decimal(15, 2)
  cogs        Decimal?     @db.Decimal(15, 2)
  order       OrderRevenue @relation(fields: [orderId], references: [orderId])

  @@id([orderId, tagCode])
  @@index([variantId])
  @@index([metalId])
}

// Header xác nhận một kho đã chốt ngày; thiếu header thì báo cáo không tự suy diễn số không.
model InventorySnapshotBatch {
  id                 String              @id @db.Uuid
  localDate          String
  warehouseId        String              @db.Uuid
  branchId           String              @db.Uuid
  payloadHash        String
  capturedAt         DateTime            @db.Timestamptz(3)
  previousCapturedAt DateTime?           @db.Timestamptz(3)
  rows               InventorySnapshot[]

  @@unique([localDate, warehouseId])
  @@index([branchId, localDate])
}

// Số chiếc, số chỉ và giá vốn tại lúc chốt; biến động chỉ gồm RECEIPT, RELEASE, SALE.
model InventorySnapshot {
  localDate      String
  warehouseId    String                 @db.Uuid
  variantId      String                 @db.Uuid
  batchId        String                 @db.Uuid
  sku            String
  metalId        String                 @db.Uuid
  metalCode      String
  metalKind      String
  onHand         Int
  weight         Decimal                @db.Decimal(18, 4)
  value          Decimal                @db.Decimal(20, 2)
  received       Int
  receivedWeight Decimal                @db.Decimal(18, 4)
  receivedValue  Decimal                @db.Decimal(20, 2)
  released       Int
  releasedWeight Decimal                @db.Decimal(18, 4)
  releasedValue  Decimal                @db.Decimal(20, 2)
  sold           Int
  soldWeight     Decimal                @db.Decimal(18, 4)
  soldValue      Decimal                @db.Decimal(20, 2)
  batch          InventorySnapshotBatch @relation(fields: [batchId], references: [id])

  @@id([localDate, warehouseId, variantId])
  @@index([metalId, localDate])
}
