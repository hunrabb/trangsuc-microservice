// Schema Prisma của auth-service.
// Prisma 7: URL kết nối KHÔNG nằm ở đây mà ở prisma.config.ts (DATABASE_URL, ?schema=auth).

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  // `nest build` không viết lại đường dẫn import: để mặc định sẽ sinh `.ts` và dist không chạy được.
  importFileExtension = "js"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// Sự kiện chờ gửi, ghi cùng transaction với dữ liệu nghiệp vụ. Worker trong libs/common gửi đi. id = eventId.
model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json
  correlationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  nextAttemptAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, createdAt])
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum AuthProvider {
  GOOGLE
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  address   String?
  phone     String?
  isActive  Boolean      @default(true)
  version   Int          @default(1)
  members   UserBranch[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique // luôn chữ thường, có CHECK trong migration
  passwordHash String? // chỉ ADMIN có giá trị
  fullName     String
  phone        String?
  status       UserStatus     @default(ACTIVE)
  version      Int            @default(1)
  branches     UserBranch[]
  tokens       RefreshToken[]
  identities   AuthIdentity[]
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
}

// Một user có vai trò ADMIN (branchId = null) tối đa một dòng: partial unique index viết tay trong migration,
// vì unique (userId, branchId) không chặn được hai dòng NULL.
model UserBranch {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String?  @db.Uuid // null = ADMIN toàn hệ thống
  role      Role
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([userId, branchId])
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique // SHA-256, không bao giờ lưu token gốc
  expiresAt        DateTime  @db.Timestamptz(3) // hạn trượt 7 ngày
  sessionStartedAt DateTime  @db.Timestamptz(3) // giữ nguyên qua mọi lần xoay vòng → hạn tuyệt đối 30 ngày
  revokedAt        DateTime? @db.Timestamptz(3)
  replacedAt       DateTime? @db.Timestamptz(3) // có giá trị khi bị xoay vòng, phân biệt với đăng xuất
  userAgent        String?
  ip               String?
  user             User      @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model AuthIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  provider  AuthProvider
  subject   String // `sub` của nhà cung cấp; không dùng email để ghép lại lần sau
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([provider, subject])
  @@unique([provider, userId])
}

// Chỉ ghi thêm. Không chứa mật khẩu, token hay cookie.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid // null = lệnh CLI trên server
  action        String
  entityType    String
  entityId      String   @db.Uuid
  data          Json
  correlationId String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
}
