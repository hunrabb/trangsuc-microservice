# Biến cho `pnpm dev` trên máy dev (app chạy trên host, Postgres chạy trong Docker).
# Sao chép thành apps/auth/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của service khi chạy trên host (mỗi app một cổng khác nhau)
PORT=3001

# Kết nối Postgres, đúng schema + user riêng. Mật khẩu phải khớp AUTH_DB_PASSWORD trong .env ở gốc.
DATABASE_URL=postgresql://auth_user:DIEN_MAT_KHAU@localhost:5432/jewelry?schema=auth

# Chỉ cho `prisma migrate dev` (database shadow, tạo sẵn bởi infra/postgres/init). Cùng user, cùng schema.
SHADOW_DATABASE_URL=postgresql://auth_user:DIEN_MAT_KHAU@localhost:5432/jewelry_shadow?schema=auth

# Kiểm tra access token. Sinh khoá: pnpm keys:generate (đường dẫn tính từ thư mục apps/auth)
JWT_PUBLIC_KEYS_DIR=../../secrets/jwt/public
JWT_ISSUER=auth-service
JWT_AUDIENCE=store-system

# Ký access token: chỉ auth có hai biến này
JWT_PRIVATE_KEY_PATH=../../secrets/jwt/private/k1.private.pem
JWT_ACTIVE_KID=k1
