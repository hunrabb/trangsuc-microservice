# Biến cho `pnpm dev` trên máy dev (app chạy trên host, Postgres chạy trong Docker).
# Sao chép thành apps/auth/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của service khi chạy trên host (mỗi app một cổng khác nhau)
PORT=3001

# Kết nối Postgres, đúng schema + user riêng. Mật khẩu phải khớp AUTH_DB_PASSWORD trong .env ở gốc.
DATABASE_URL=postgresql://auth_user:DIEN_MAT_KHAU@localhost:5432/jewelry?schema=auth

# Chỉ cho `prisma migrate dev` (database shadow, tạo sẵn bởi infra/postgres/init). Cùng user, cùng schema.
SHADOW_DATABASE_URL=postgresql://auth_user:DIEN_MAT_KHAU@localhost:5432/jewelry_shadow?schema=auth

# Kiểm tra access token. Sinh khoá: pnpm keys:generate (đường dẫn tính từ thư mục apps/auth)
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE_BACKOFFICE=store-backoffice
JWT_AUDIENCE_SHOP=store-shop

# Ký access token: chỉ auth có biến này
JWT_PRIVATE_KEY_PATH=../../secrets/jwt/private.pem

# Client ID của OAuth 2.0 (loại Web) trong Google Cloud Console, xem README. Không phải bí mật.
GOOGLE_CLIENT_ID=dien-client-id.apps.googleusercontent.com
# Mặc định là địa chỉ của Google; chỉ đổi khi test.
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Số kết nối Postgres tối đa của service. Service có consumer cần tối thiểu 15 (prefetch 10 + 5).
DATABASE_POOL_MAX=20

# Kết nối RabbitMQ bằng user ứng dụng. Mật khẩu phải khớp RABBITMQ_APP_PASSWORD trong .env ở gốc.
RABBITMQ_URL=amqp://jewelry_app:DIEN_MAT_KHAU@localhost:5672
