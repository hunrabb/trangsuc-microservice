# Biến cho `pnpm dev` trên máy dev (app chạy trên host, Postgres chạy trong Docker).
# Sao chép thành apps/inventory/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của service khi chạy trên host (mỗi app một cổng khác nhau)
PORT=3002

# Kết nối Postgres, đúng schema + user riêng. Mật khẩu phải khớp INVENTORY_DB_PASSWORD trong .env ở gốc.
DATABASE_URL=postgresql://inventory_user:DIEN_MAT_KHAU@127.0.0.1:15434/inventory_db?schema=inventory

# Chỉ cho `prisma migrate dev` (database shadow, tạo sẵn bởi infra/postgres/service-init). Cùng user, cùng schema.
SHADOW_DATABASE_URL=postgresql://inventory_user:DIEN_MAT_KHAU@127.0.0.1:15434/inventory_shadow?schema=inventory

# Kiểm tra access token. Sinh khoá: pnpm keys:generate (đường dẫn tính từ thư mục apps/inventory)
JWT_PUBLIC_KEY_PATH=../../secrets/jwt/public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE_BACKOFFICE=store-backoffice
JWT_AUDIENCE_SHOP=store-shop

# Số kết nối Postgres tối đa của service. Service có consumer cần tối thiểu 15 (prefetch 10 + 5).
DATABASE_POOL_MAX=20

# Kết nối RabbitMQ bằng user ứng dụng. Mật khẩu phải khớp RABBITMQ_APP_PASSWORD trong .env ở gốc.
RABBITMQ_URL=amqp://jewelry_app:DIEN_MAT_KHAU@localhost:5672
