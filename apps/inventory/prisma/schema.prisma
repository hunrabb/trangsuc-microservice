// Schema Prisma của inventory-service.
// Prisma 7: URL kết nối KHÔNG nằm ở đây mà ở prisma.config.ts (DATABASE_URL, ?schema=inventory).

datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // `nest build` không viết lại đường dẫn import: để mặc định sẽ sinh `.ts` và dist không chạy được.
  importFileExtension = "js"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// Sự kiện chờ gửi, ghi cùng transaction với dữ liệu nghiệp vụ. Worker trong libs/common gửi đi. id = eventId.
model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json
  correlationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  nextAttemptAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, createdAt])
}

// Chống xử lý trùng: ghi cùng transaction với việc nghiệp vụ. Một thư có thể tới nhiều consumer nên khoá gồm cả consumer.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumer])
}

// ---------------------------------------------------------------- Danh mục kim loại và giá
// Chỉ vàng (nhiều tuổi) và bạc. Mỗi dòng `Metal` là một loại cụ thể, ví dụ "Vàng 18K", "Bạc 925".
enum MetalKind {
  GOLD
  SILVER
}

model Metal {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique
  name      String
  kind      MetalKind
  isActive  Boolean          @default(true)
  version   Int              @default(1)
  prices    MetalPrice[]
  variants  ProductVariant[]
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
}

// Chỉ ghi thêm. Giá hiện tại = dòng có `effectiveFrom` mới nhất `<= now()`. Đơn vị: đồng / chỉ.
model MetalPrice {
  id            String   @id @default(uuid()) @db.Uuid
  metalId       String   @db.Uuid
  buyPrice      Decimal  @db.Decimal(15, 2)
  sellPrice     Decimal  @db.Decimal(15, 2)
  effectiveFrom DateTime @db.Timestamptz(3)
  createdBy     String   @db.Uuid
  metal         Metal    @relation(fields: [metalId], references: [id])
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([metalId, effectiveFrom(sort: Desc)])
}

// ---------------------------------------------------------------- Sản phẩm
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  isActive  Boolean   @default(true)
  version   Int       @default(1)
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @db.Uuid
  name        String
  description String?
  isActive    Boolean          @default(true)
  version     Int              @default(1)
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
}

// Biến thể = mẫu + loại kim loại. Tiền công mặc định chỉ để điền sẵn khi nhập hàng; mỗi chiếc có tiền công riêng.
model ProductVariant {
  id              String             @id @default(uuid()) @db.Uuid
  productId       String             @db.Uuid
  metalId         String             @db.Uuid
  sku             String             @unique
  name            String
  defaultLaborFee Decimal            @default(0) @db.Decimal(15, 2)
  isActive        Boolean            @default(true)
  version         Int                @default(1)
  product         Product            @relation(fields: [productId], references: [id])
  metal           Metal              @relation(fields: [metalId], references: [id])
  items           JewelryItem[]
  receiptLines    GoodsReceiptLine[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([productId])
  @@index([metalId])
}

// ---------------------------------------------------------------- Kho và hàng có tem
// Mỗi chi nhánh đúng một kho; tạo khi nhận `branch.created`. `branchId` chỉ là id, không có khoá ngoại sang auth.
model Warehouse {
  id          String         @id @default(uuid()) @db.Uuid
  branchId    String         @unique @db.Uuid
  name        String
  isActive    Boolean        @default(true)
  version     Int            @default(1)
  items       JewelryItem[]
  receipts    GoodsReceipt[]
  stockCounts StockCount[]
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
}

enum ItemStatus {
  IN_STOCK
  RESERVED
  SOLD
}

// Mỗi chiếc một dòng. Tồn kho = số chiếc `IN_STOCK`. Mọi đổi trạng thái là UPDATE có điều kiện trên `status`.
model JewelryItem {
  id               String          @id @default(uuid()) @db.Uuid
  tagCode          String          @unique
  variantId        String          @db.Uuid
  warehouseId      String          @db.Uuid
  weight           Decimal         @db.Decimal(12, 4) // chỉ
  laborFee         Decimal         @db.Decimal(15, 2)
  costPrice        Decimal         @db.Decimal(15, 2)
  status           ItemStatus      @default(IN_STOCK)
  version          Int             @default(1)
  // Chỉ có giá trị khi `status = SOLD` (CHECK trong migration): đơn đang giữ chiếc này, và giá chốt lúc trừ kho
  // để gọi lại `deduct` cùng `orderId` trả đúng kết quả cũ, không tính lại theo giá kim loại mới.
  orderId          String?         @db.Uuid
  soldAt           DateTime?       @db.Timestamptz(3)
  metalPriceAtSale Decimal?        @db.Decimal(15, 2)
  priceAtSale      Decimal?        @db.Decimal(15, 2)
  variant          ProductVariant  @relation(fields: [variantId], references: [id])
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])
  movements        StockMovement[]
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([warehouseId, status])
  @@index([variantId])
  @@index([orderId])
}

// ---------------------------------------------------------------- Phiếu nhập
enum ReceiptStatus {
  DRAFT
  APPROVED
}

model GoodsReceipt {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique
  warehouseId String             @db.Uuid
  status      ReceiptStatus      @default(DRAFT)
  note        String?
  createdBy   String             @db.Uuid
  approvedBy  String?            @db.Uuid
  approvedAt  DateTime?          @db.Timestamptz(3)
  version     Int                @default(1)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  lines       GoodsReceiptLine[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([warehouseId, status])
}

// Mỗi dòng là một chiếc (một mã tem).
model GoodsReceiptLine {
  id        String         @id @default(uuid()) @db.Uuid
  receiptId String         @db.Uuid
  variantId String         @db.Uuid
  tagCode   String
  weight    Decimal        @db.Decimal(12, 4)
  laborFee  Decimal        @db.Decimal(15, 2)
  costPrice Decimal        @db.Decimal(15, 2)
  receipt   GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([receiptId, tagCode])
}

// ---------------------------------------------------------------- Chỉ ghi thêm
enum MovementType {
  RECEIPT
  SALE
  RELEASE
  COUNT_MISSING
}

model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  jewelryItemId String       @db.Uuid
  warehouseId   String       @db.Uuid
  type          MovementType
  toStatus      ItemStatus
  refType       String
  refId         String       @db.Uuid
  createdBy     String?      @db.Uuid // null = do service khác gọi qua /internal
  item          JewelryItem  @relation(fields: [jewelryItemId], references: [id])
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  // Chống ghi trùng sổ kho: `deduct` hoặc `release` lặp lại, kể cả song song, không thêm dòng thứ hai.
  @@unique([refType, refId, jewelryItemId, type])
  @@index([jewelryItemId])
  @@index([refType, refId])
}

// Chỉ ghi thêm. Không chứa dữ liệu nhạy cảm.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String   @db.Uuid
  data          Json
  correlationId String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------- Kiểm kê
enum StockCountStatus {
  OPEN
  CLOSED
}

// Trạng thái của một chiếc trong phiên kiểm kê (không phải `ItemStatus` của chiếc hàng).
//   EXPECTED: dự kiến có, chưa quét     SCANNED: đã quét thấy
//   MISSING:  khi đóng phiên vẫn không thấy, và chiếc còn `IN_STOCK`
//   MOVED:    khi đóng phiên chiếc không còn `IN_STOCK` (đã bán hoặc đang giữ trong lúc kiểm kê), không tính thiếu
enum StockCountLineStatus {
  EXPECTED
  SCANNED
  MISSING
  MOVED
}

// Mỗi kho tối đa MỘT phiên đang mở: partial unique index viết tay trong migration (Prisma không sinh).
model StockCount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  warehouseId String            @db.Uuid
  status      StockCountStatus  @default(OPEN)
  createdBy   String            @db.Uuid
  closedBy    String?           @db.Uuid
  closedAt    DateTime?         @db.Timestamptz(3)
  version     Int               @default(1)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  lines       StockCountLine[]
  extras      StockCountExtra[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([warehouseId, status])
}

// Danh sách chiếc dự kiến, chụp lúc mở phiên. Không đổi trạng thái chiếc hàng.
model StockCountLine {
  id            String               @id @default(uuid()) @db.Uuid
  stockCountId  String               @db.Uuid
  jewelryItemId String               @db.Uuid
  tagCode       String
  status        StockCountLineStatus @default(EXPECTED)
  scannedBy     String?              @db.Uuid
  scannedAt     DateTime?            @db.Timestamptz(3)
  stockCount    StockCount           @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([stockCountId, tagCode])
  @@unique([stockCountId, jewelryItemId])
}

// Mã quét được nhưng không thuộc danh sách dự kiến ("thừa"). Chỉ để báo cáo, không tự thêm vào kho.
model StockCountExtra {
  id           String     @id @default(uuid()) @db.Uuid
  stockCountId String     @db.Uuid
  tagCode      String
  scannedBy    String     @db.Uuid
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([stockCountId, tagCode])
}
