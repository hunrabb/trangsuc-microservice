{
  "name": "@jewelry/sales",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "report:backfill:export": "node dist/cli/report-backfill-export.js",
    "test:backfill": "node test/historical-orders.test.mjs",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node ../../scripts/run-tests.mjs \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:catalog": "node test/catalog.test.mjs",
    "test:online": "node test/online-checkout.test.mjs",
    "test:online-payments": "node test/online-payments.test.mjs",
    "test:buybacks": "node test/buybacks.test.mjs"
  },
  "dependencies": {
    "@jewelry/common": "workspace:*",
    "@jewelry/contracts": "workspace:*",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
