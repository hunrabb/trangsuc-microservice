// Schema Prisma của sales-service.
// Prisma 7: URL kết nối KHÔNG nằm ở đây mà ở prisma.config.ts (DATABASE_URL, ?schema=sales).

datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // `nest build` không viết lại đường dẫn import: để mặc định sẽ sinh `.ts` và dist không chạy được.
  importFileExtension = "js"
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// Sự kiện chờ gửi, ghi cùng transaction với dữ liệu nghiệp vụ. Worker trong libs/common gửi đi. id = eventId.
model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String       @db.Uuid
  payload       Json
  correlationId String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lockedUntil   DateTime?    @db.Timestamptz(3)
  nextAttemptAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  publishedAt   DateTime?    @db.Timestamptz(3)

  @@index([status, createdAt])
}

// Chống xử lý trùng: ghi cùng transaction với việc nghiệp vụ. Một thư có thể tới nhiều consumer nên khoá gồm cả consumer.
model ProcessedEvent {
  eventId     String   @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, consumer])
}

enum OrderStatus {
  CREATING
  PENDING_PAYMENT
  COMPLETED
  CANCELLING
  CANCELLED
}

// Khách POS theo số điện thoại chuẩn hoá; một người có thể mua ở nhiều chi nhánh.
model Customer {
  id             String          @id @default(uuid()) @db.Uuid
  phone          String          @unique
  name           String
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  orders         Order[]
  buybackIntakes BuybackIntake[]
}

// Giữ key ngay trước HTTP; lease cho phép request khác tiếp tục nếu tiến trình cũ chết.
model Order {
  id                String               @id @default(uuid()) @db.Uuid
  code              String               @unique
  branchId          String               @db.Uuid
  customerId        String?              @db.Uuid
  status            OrderStatus          @default(CREATING)
  idempotencyKey    String               @unique
  requestHash       String
  requestedTagCodes String[]
  total             Decimal              @default(0) @db.Decimal(15, 2)
  version           Int                  @default(1)
  createdBy         String               @db.Uuid
  operationOwner    String?              @db.Uuid
  operationUntil    DateTime?            @db.Timestamptz(3)
  deductionStarted  Boolean              @default(false)
  failureCode       String?
  failureHttpStatus Int?
  failedTagCodes    String[]             @default([])
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  items             OrderItem[]
  tradeInItems      TradeInItem[]
  buybackSettlement BuybackSettlement?
  history           OrderStatusHistory[]
  customer          Customer?            @relation(fields: [customerId], references: [id])

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
}

// Snapshot do inventory trả lúc deduct; không có khoá ngoại qua schema inventory.
model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @db.Uuid
  jewelryItemId    String   @db.Uuid
  tagCode          String
  productName      String
  metalWeight      Decimal  @db.Decimal(12, 4)
  laborFee         Decimal  @db.Decimal(15, 2)
  stoneFee         Decimal  @default(0) @db.Decimal(15, 2)
  metalPriceAtSale Decimal  @db.Decimal(15, 2)
  price            Decimal  @db.Decimal(15, 2)
  costPrice        Decimal  @default(0) @db.Decimal(15, 2)
  variantId        String?  @db.Uuid
  metalId          String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  order            Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, tagCode])
}

// Chỉ ghi thêm, bao gồm trạng thái trung gian để truy được lần xử lý dở.
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String       @db.Uuid
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @default(now()) @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

// Nhật ký huỷ hoá đơn theo CLAUDE.md mục 9; chỉ ghi thêm.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  orderId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

// Bản sao chỉ chứa dữ liệu công khai. Không có FK sang Inventory.
model CatalogProduct {
  id           String           @id @db.Uuid
  categoryId   String           @db.Uuid
  categoryName String
  name         String
  description  String?
  imageUrl     String?
  isActive     Boolean
  version      Int
  capturedAt   DateTime         @db.Timestamptz(3)
  variants     CatalogVariant[]

  @@index([isActive, categoryId, name])
}

model CatalogVariant {
  id             String         @id @db.Uuid
  productId      String         @db.Uuid
  sku            String
  name           String
  metalKind      String
  estimatedPrice Decimal?       @db.Decimal(20, 2)
  product        CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CatalogAvailability {
  variantId  String   @id @db.Uuid
  available  Int
  version    Int
  capturedAt DateTime @db.Timestamptz(3)
}

// Đơn online tách khỏi Order POS vốn yêu cầu branchId/createdBy ngay lúc tạo.
// Cùng schema Sales; không tạo database hoặc truy cập Inventory DB.
enum OnlineOrderStatus {
  PAYMENT_PROCESSING
  CONFIRMED
  PAYMENT_REVIEW
  REFUND_PENDING
  PENDING
  AWAITING_PAYMENT
  CANCELLED
}

model OnlineOrder {
  accountId       String?              @db.Uuid // Auth customer identity; no cross-service foreign key.
  activePaymentId String?              @db.Uuid
  paymentAttempts Int                  @default(0)
  payments        OnlinePayment[]
  paymentAudit    OnlinePaymentAudit[]
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @unique
  status          OnlineOrderStatus    @default(PENDING)
  accessHash      String
  idempotencyKey  String
  requestHash     String
  requestedItems  Json
  recipientName   String
  recipientPhone  String
  shippingAddress String
  email           String?
  reservationId   String?              @db.Uuid
  warehouseId     String?              @db.Uuid
  branchId        String?              @db.Uuid
  total           Decimal?             @db.Decimal(20, 2)
  expiresAt       DateTime?            @db.Timestamptz(3)
  deadlineAt      DateTime             @db.Timestamptz(3)
  needsReview     Boolean              @default(false)
  recoveryAfter   DateTime             @db.Timestamptz(3)
  failureCode     String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  items           OnlineOrderItem[]

  @@index([accountId, createdAt, id])
  @@unique([accessHash, idempotencyKey])
  @@index([status, recoveryAfter])
}

model OnlineOrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  jewelryItemId String      @db.Uuid
  variantId     String      @db.Uuid
  sku           String
  productName   String
  price         Decimal     @db.Decimal(20, 2)
  order         OnlineOrder @relation(fields: [orderId], references: [id])

  @@unique([orderId, jewelryItemId])
}

// Tiền nhận thực được nhân viên có quyền xác minh từ sao kê, không từ frontend khách.
enum OnlinePaymentStatus {
  RECEIVED
  INVENTORY_CONFIRMED
  RECONCILIATION_REQUIRED
  REFUND_PENDING
}

model OnlinePayment {
  requests         OnlinePaymentRequest[]
  inventoryVersion Int                    @default(0)
  id               String                 @id @default(uuid()) @db.Uuid
  orderId          String                 @db.Uuid
  bankTxnRef       String                 @unique
  amount           Decimal                @db.Decimal(20, 2)
  currency         String                 @default("VND")
  evidenceRef      String
  actorId          String                 @db.Uuid
  idempotencyKey   String
  requestHash      String
  status           OnlinePaymentStatus
  receivedAt       DateTime               @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  order            OnlineOrder            @relation(fields: [orderId], references: [id])

  @@unique([actorId, idempotencyKey])
  @@index([orderId, createdAt])
}

model OnlinePaymentAudit {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  paymentId  String?     @db.Uuid
  actorId    String?     @db.Uuid
  action     String
  fromStatus String
  toStatus   String
  reason     String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  order      OnlineOrder @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

// Mọi key được trả thành công đều gắn với cùng kết quả, kể cả alias của bankTxnRef đã có.
model OnlinePaymentRequest {
  id             String        @id @default(uuid()) @db.Uuid
  actorId        String        @db.Uuid
  idempotencyKey String
  requestHash    String
  paymentId      String        @db.Uuid
  payment        OnlinePayment @relation(fields: [paymentId], references: [id])

  @@unique([actorId, idempotencyKey])
}

// Task 7.1: hồ sơ tiếp nhận; chưa là giao dịch mua hoặc quyền sở hữu hàng.
enum BuybackIntakeStatus {
  DRAFT
  PENDING_APPRAISAL
  CANCELLED
  APPRAISED
  APPROVED
  REJECTED
}

enum BuybackAssetKind {
  GOLD
  SILVER
  JEWELRY
}

enum BuybackItemSource {
  STORE_TAG
  EXTERNAL
}

enum BuybackAuditAction {
  CREATED
  UPDATED
  SUBMITTED
  CANCELLED
  APPRAISED
  QUOTED
  APPROVED
  REJECTED
}

model BuybackIntake {
  activeQuoteId      String?              @db.Uuid
  activeQuote        BuybackQuote?        @relation("ActiveBuybackQuote", fields: [id, activeQuoteId], references: [intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "BuybackIntake_activeQuote_fkey")
  appraisals         BuybackAppraisal[]
  quotes             BuybackQuote[]       @relation("BuybackQuotes")
  requests           BuybackRequest[]
  settlements        BuybackSettlement[]
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique
  branchId           String               @db.Uuid
  createdBy          String               @db.Uuid
  idempotencyKey     String
  requestHash        String
  customerId         String?              @db.Uuid
  customerName       String
  customerPhone      String
  notes              String?
  status             BuybackIntakeStatus  @default(DRAFT)
  version            Int                  @default(1)
  receivedAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  submittedAt        DateTime?            @db.Timestamptz(3)
  cancelledAt        DateTime?            @db.Timestamptz(3)
  cancellationReason String?
  customer           Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items              BuybackIntakeItem[]
  audit              BuybackIntakeAudit[]

  @@unique([branchId, createdBy, idempotencyKey])
  @@index([branchId, status, receivedAt, id])
  @@index([branchId, receivedAt, id])
  @@index([customerId])
}

model BuybackIntakeItem {
  appraisals            BuybackAppraisal[]
  id                    String             @id @default(uuid()) @db.Uuid
  intakeId              String             @db.Uuid
  position              Int
  source                BuybackItemSource
  referenceTagCode      String?
  assetKind             BuybackAssetKind
  description           String
  condition             String
  declaredWeight        Decimal?           @db.Decimal(12, 4)
  initialMeasuredWeight Decimal?           @db.Decimal(12, 4)
  declaredPurity        String?
  notes                 String?
  intake                BuybackIntake      @relation(fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([intakeId, position])
}

// Chỉ append, không lưu bản sao tên/số điện thoại/nội dung khách vào audit.
model BuybackIntakeAudit {
  id          String               @id @default(uuid()) @db.Uuid
  intakeId    String               @db.Uuid
  branchId    String               @db.Uuid
  actorId     String               @db.Uuid
  action      BuybackAuditAction
  fromStatus  BuybackIntakeStatus?
  toStatus    BuybackIntakeStatus
  fromVersion Int?
  toVersion   Int
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  intake      BuybackIntake        @relation(fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([intakeId, toVersion])
}

// Immutable appraisal revisions. Header lock serializes all item changes/quote decisions.
model BuybackAppraisal {
  id             String             @id @default(uuid()) @db.Uuid
  intakeId       String             @db.Uuid
  itemId         String             @db.Uuid
  intakeVersion  Int
  measuredWeight Decimal            @db.Decimal(12, 4)
  acceptedWeight Decimal            @db.Decimal(12, 4)
  metalId        String             @db.Uuid
  metalKind      String
  purityPerMille Decimal            @db.Decimal(8, 4)
  condition      String
  notes          String?
  appraisedBy    String             @db.Uuid
  appraisedAt    DateTime           @default(now()) @db.Timestamptz(3)
  intake         BuybackIntake      @relation(fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  item           BuybackIntakeItem  @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines          BuybackQuoteLine[]

  @@unique([itemId, intakeVersion])
  @@index([intakeId, itemId, intakeVersion])
}

// Configured deductions/purity mapping; buy prices remain owned by Inventory.
model BuybackPricePolicy {
  id                  String               @id @default(uuid()) @db.Uuid
  branchId            String               @db.Uuid
  metalId             String               @db.Uuid
  metalKind           String
  purityPerMille      Decimal              @db.Decimal(8, 4)
  label               String
  deductionVndPerItem Decimal              @db.Decimal(15, 2)
  version             Int                  @default(1)
  isActive            Boolean              @default(true)
  createdBy           String               @db.Uuid
  idempotencyKey      String
  requestHash         String
  updatedAt           DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  audit               BuybackPolicyAudit[]
  lines               BuybackQuoteLine[]

  @@unique([branchId, createdBy, idempotencyKey])
  @@index([branchId, isActive, id])
}

model BuybackPolicyAudit {
  id        String             @id @default(uuid()) @db.Uuid
  policyId  String             @db.Uuid
  version   Int
  actorId   String             @db.Uuid
  reason    String
  snapshot  Json
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  policy    BuybackPricePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([policyId, version])
}

model BuybackQuote {
  id                      String             @id @default(uuid()) @db.Uuid
  intakeId                String             @db.Uuid
  sourceVersion           Int
  status                  String             @default("QUOTED")
  currency                String             @default("VND")
  total                   Decimal            @db.Decimal(20, 2)
  rounding                String
  requireSeparateApprover Boolean            @default(true)
  quotedBy                String             @db.Uuid
  quotedAt                DateTime           @default(now()) @db.Timestamptz(3)
  decidedBy               String?            @db.Uuid
  decidedAt               DateTime?          @db.Timestamptz(3)
  rejectionReason         String?
  intake                  BuybackIntake      @relation("BuybackQuotes", fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeFor               BuybackIntake[]    @relation("ActiveBuybackQuote")
  lines                   BuybackQuoteLine[]
  settlements             BuybackSettlement[]

  @@unique([intakeId, id])
  @@index([intakeId, quotedAt, id])
}

model BuybackQuoteLine {
  id                  String             @id @default(uuid()) @db.Uuid
  quoteId             String             @db.Uuid
  itemId              String             @db.Uuid
  appraisalId         String             @db.Uuid
  appraisedBy         String             @db.Uuid
  measuredWeight      Decimal            @db.Decimal(12, 4)
  acceptedWeight      Decimal            @db.Decimal(12, 4)
  metalId             String             @db.Uuid
  metalKind           String
  purityPerMille      Decimal            @db.Decimal(8, 4)
  policyId            String             @db.Uuid
  policyVersion       Int
  priceId             String             @db.Uuid
  metalCode           String
  unit                String
  unitPrice           Decimal            @db.Decimal(15, 2)
  effectiveFrom       DateTime           @db.Timestamptz(3)
  capturedAt          DateTime           @db.Timestamptz(3)
  deductionVndPerItem Decimal            @db.Decimal(15, 2)
  amount              Decimal            @db.Decimal(20, 2)
  quote               BuybackQuote       @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  appraisal           BuybackAppraisal   @relation(fields: [appraisalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  policy              BuybackPricePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tradeInItems        TradeInItem[]

  @@unique([quoteId, itemId])
}

model TradeInItem {
  id             String           @id @default(uuid()) @db.Uuid
  orderId        String           @db.Uuid
  quoteLineId    String           @unique @db.Uuid
  intakeItemId   String           @db.Uuid
  metalId        String           @db.Uuid
  acceptedWeight Decimal          @db.Decimal(12, 4)
  amount         Decimal          @db.Decimal(20, 2)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quoteLine      BuybackQuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderId])
}

model BuybackRequest {
  id             String        @id @default(uuid()) @db.Uuid
  intakeId       String        @db.Uuid
  actorId        String        @db.Uuid
  idempotencyKey String
  requestHash    String
  result         Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  intake         BuybackIntake @relation(fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([intakeId, actorId, idempotencyKey])
}

enum BuybackSettlementKind {
  DIRECT
  EXCHANGE
}

enum BuybackSettlementStatus {
  RESERVING
  AWAITING_PAYMENT
  PAYMENT_RECORDED
  FULFILLING
  SETTLED
  RECONCILIATION_REQUIRED
  CANCELLING
  CANCELLED
}

enum BuybackPaymentDirection {
  STORE_PAYS
  CUSTOMER_PAYS
  NONE
}

enum BuybackPaymentMethod {
  CASH
  BANK_TRANSFER
}

model BuybackSettlement {
  id                    String                  @id @default(uuid()) @db.Uuid
  intakeId              String                  @db.Uuid
  quoteId               String                  @db.Uuid
  branchId              String                  @db.Uuid
  kind                  BuybackSettlementKind
  status                BuybackSettlementStatus
  version               Int                     @default(1)
  method                BuybackPaymentMethod
  approvedAmount        Decimal                 @db.Decimal(20, 2)
  saleAmount            Decimal?                @db.Decimal(20, 2)
  difference            Decimal?                @db.Decimal(20, 2)
  direction             BuybackPaymentDirection?
  amountDue             Decimal?                @db.Decimal(20, 2)
  tagCode               String?
  reservationId         String?                 @db.Uuid
  reservationExpiresAt  DateTime?               @db.Timestamptz(3)
  saleSnapshot          Json?
  paymentReference      String?                 @unique
  paymentEvidence       String?
  paymentRecordedBy     String?                 @db.Uuid
  paymentConfirmedBy    String?                 @db.Uuid
  paymentConfirmedAt    DateTime?               @db.Timestamptz(3)
  verificationReference String?
  confirmationNote      String?
  orderId               String?                 @unique @db.Uuid
  failureCode           String?
  recoveryAttempts      Int                     @default(0)
  createdBy             String                  @db.Uuid
  creationKey           String
  creationHash          String
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  intake                BuybackIntake           @relation(fields: [intakeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quote                 BuybackQuote            @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  exchangeOrder         Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  audit                 BuybackSettlementAudit[]
  requests              BuybackSettlementRequest[]

  @@index([status, updatedAt])
  @@index([branchId, createdAt])
  @@index([intakeId, createdAt])
  @@unique([intakeId, createdBy, creationKey])
}

model BuybackSettlementAudit {
  id           String                   @id @default(uuid()) @db.Uuid
  settlementId String                   @db.Uuid
  actorId      String?                  @db.Uuid
  action       String
  fromStatus   BuybackSettlementStatus?
  toStatus     BuybackSettlementStatus
  fromVersion  Int?
  toVersion    Int
  detail       Json
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  settlement   BuybackSettlement        @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([settlementId, toVersion])
}

model BuybackSettlementRequest {
  id             String            @id @default(uuid()) @db.Uuid
  settlementId   String            @db.Uuid
  actorId        String            @db.Uuid
  idempotencyKey String
  requestHash    String
  result         Json
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  settlement     BuybackSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([settlementId, actorId, idempotencyKey])
}
