# Biến cho `pnpm dev` trên máy dev (app chạy trên host).
# Sao chép thành apps/gateway/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của gateway khi chạy trên host (frontend dev proxy /api về cổng này)
PORT=3000

# Địa chỉ inventory-service khi chạy trên host (xem PORT trong apps/inventory/.env)
INVENTORY_URL=http://localhost:3002
