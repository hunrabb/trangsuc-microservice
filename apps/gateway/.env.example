# Biến cho `pnpm dev` trên máy dev (app chạy trên host).
# Sao chép thành apps/gateway/.env. Docker Compose KHÔNG đọc file này (xem .env.example ở gốc).

# Cổng HTTP của gateway khi chạy trên host (frontend dev proxy /api về cổng này)
PORT=3000

# Địa chỉ các service khi chạy trên host (xem PORT trong apps/<app>/.env)
AUTH_URL=http://localhost:3001
INVENTORY_URL=http://localhost:3002
SALES_URL=http://localhost:3003
REPORT_URL=http://localhost:3004

# Kiểm tra access token. Sinh khoá: pnpm keys:generate (đường dẫn tính từ thư mục apps/gateway)
JWT_PUBLIC_KEYS_DIR=../../secrets/jwt/public
JWT_ISSUER=auth-service
JWT_AUDIENCE_BACKOFFICE=store-backoffice
JWT_AUDIENCE_SHOP=store-shop

# Proxy được tin khi đọc X-Forwarded-For (IP hoặc CIDR, phân cách bằng dấu phẩy). Chạy trên máy dev thì để trống.
TRUSTED_PROXIES=
