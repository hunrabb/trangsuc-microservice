# Nếu chưa có .env, sao chép rồi điền giá trị:   test -f .env || cp .env.example .env
# File này dành cho Docker Compose. KHÔNG commit .env. Để trống = chưa điền (compose sẽ dừng và báo tên biến).
#
# Mật khẩu: dùng chuỗi ngẫu nhiên chỉ gồm chữ và số (đi vào URL kết nối nên không dùng @ : / ? # $ %).
# Tạo nhanh:   openssl rand -hex 24

# ---------------------------------------------------------------- PostgreSQL
# Tài khoản quản trị Postgres (chỉ dùng để khởi tạo và vào psql, các service KHÔNG dùng)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Chỉ dùng khi bật profile legacy-db để kiểm tra DB cũ; Compose mặc định dùng
# auth_db, inventory_db, sales_db, report_db ở bốn container/volume độc lập.
POSTGRES_DB=jewelry
# Chỉ dành cho DB legacy; mỗi DB mới tự tạo <service>_shadow riêng.
POSTGRES_SHADOW_DB=jewelry_shadow
# Mật khẩu của từng user DB; mỗi service chỉ nhận mật khẩu của chính nó
AUTH_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
SALES_DB_PASSWORD=
REPORT_DB_PASSWORD=
# Số kết nối Postgres tối đa của MỖI service. Service có consumer cần tối thiểu 15 (prefetch 10 + 5), thiếu thì không bật.
DATABASE_POOL_MAX=20
# LƯU Ý: mật khẩu Postgres chỉ được init khi volume tương ứng còn trống.
# Đổi mật khẩu trên DB đã có dữ liệu bằng ALTER ROLE theo runbook; không xóa volume.

# ---------------------------------------------------------------- RabbitMQ
# Tài khoản quản trị: đăng nhập trang quản lý (http://localhost:15672 khi dev) và nạp topology
RABBITMQ_ADMIN_USER=rabbit_admin
RABBITMQ_ADMIN_PASSWORD=
# Tài khoản cho các service (do container rabbitmq-setup tạo / cập nhật mỗi lần chạy)
RABBITMQ_APP_USER=jewelry_app
RABBITMQ_APP_PASSWORD=

# ---------------------------------------------------------------- JWT
# Sinh khoá trước khi chạy: pnpm keys:generate (tạo secrets/jwt/private.pem và secrets/jwt/public.pem)
JWT_ISSUER=auth-service
# Hai loại token, cùng issuer: nhân viên và khách
JWT_AUDIENCE_BACKOFFICE=store-backoffice
JWT_AUDIENCE_SHOP=store-shop
# auth chạy bằng uid 1000 trong container nên phải đọc được secrets/jwt/private.pem (xem README).

# ---------------------------------------------------------------- Đăng nhập Google
# Client ID của OAuth 2.0 (loại Web) trong Google Cloud Console, xem README. Không phải bí mật.
GOOGLE_CLIENT_ID=dien-client-id.apps.googleusercontent.com
POS_BANK_BIN=
POS_BANK_ACCOUNT=
POS_BANK_NAME=

# ---------------------------------------------------------------- IP thật của người dùng
# Gateway chỉ tin X-Forwarded-For từ các địa chỉ này. Mặc định là hai nginx trong mạng Compose.
# KHÔNG đặt cả mạng 172.30.0.0/24: kết nối từ ngoài qua cổng đã mở có thể mang địa chỉ bridge trong mạng đó.
# Có reverse proxy phía trước (Caddy...) thì thêm địa chỉ của nó.
TRUSTED_PROXIES=172.30.0.16/31

# ---------------------------------------------------------------- Cổng mở ra máy chủ
# Gateway (API)
GATEWAY_PORT=3000
# Backoffice (admin + POS)
BACKOFFICE_PORT=8080
# Storefront (website bán hàng)
STOREFRONT_PORT=8081
